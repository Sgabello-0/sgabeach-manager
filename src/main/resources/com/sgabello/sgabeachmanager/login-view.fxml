<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sgabello.sgabeachmanager.controllers.LoginController">

    <top>
        <VBox style="-fx-font-weight: bold; -fx-padding: 20; -fx-border-color: transparent #cccccc transparent transparent; -fx-border-width: 0 0 1 0;" alignment="CENTER">
            <Label text="SgaBeach Manager" style="-fx-font-size: 32"/>
            <Label text="Gestionale Spiaggia" style="-fx-font-size: 24"/>
        </VBox>
    </top>
    <center>
        <VBox alignment="CENTER">
            <HBox>
                <Label text="Utente"/>
                <TextField prefWidth="130" fx:id="userField"/>
            </HBox>
            <HBox>
                <Label text="Password"/>
                <PasswordField prefWidth="130" fx:id="passwordField"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
