<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sgabello.sgabeachmanager.controllers.LoginController">

    <center>
        <VBox alignment="CENTER">
            <VBox style="-fx-font-weight: bold; -fx-padding: 50; -fx-border-color: transparent #cccccc transparent transparent; -fx-border-width: 0 0 1 0;" alignment="CENTER">
                <Label text="SgaBeach Manager" style="-fx-font-size: 32"/>
                <Label text="Gestionale Spiaggia" style="-fx-font-size: 24"/>
            </VBox>
            <HBox style="-fx-padding: 10" alignment="CENTER" spacing="20">
                <Label text="Utente" prefWidth="70"/>
                <TextField prefWidth="180" fx:id="userField"/>
            </HBox>
            <HBox style="-fx-padding: 10" alignment="CENTER" spacing="20">
                <Label text="Password" prefWidth="70"/>
                <PasswordField prefWidth="180" fx:id="passwordField"/>
            </HBox>
            <HBox style="-fx-padding: 40" alignment="CENTER" spacing="20">
                <Button fx:id="loginButton" prefWidth="100"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
