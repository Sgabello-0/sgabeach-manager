<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sgabello.sgabeachmanager.controllers.ClientsController">

    <top>
        <HBox style="-fx-padding: 20 20 10 20;">
            <Label text="Clients" style="-fx-font-size: 24; -fx-font-weight: bold;" alignment="CENTER"/>
        </HBox>
    </top>
    <Separator/>
    <center>
        <TableView fx:id="tabellaClienti" style="-fx-padding: 0 20 20 20;">
            <columns>
                <TableColumn fx:id="colNome"     text="First name"   prefWidth="200"/>
                <TableColumn fx:id="colCognome"  text="Last name"    prefWidth="200"/>
                <TableColumn fx:id="colTelefono" text="Phone number" prefWidth="200"/>
            </columns>
        </TableView>
    </center>

</BorderPane>
