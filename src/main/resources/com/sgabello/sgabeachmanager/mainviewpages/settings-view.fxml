<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane fitToWidth="true"
            style="-fx-background-color: transparent;"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sgabello.sgabeachmanager.controllers.SettingsController">
    <HBox alignment="CENTER">
        <VBox spacing="30" style="-fx-padding: 30; -fx-font-size: 16;" alignment="TOP_CENTER" maxWidth="600">
            <VBox spacing="10">
                <Label text="Configurazione Spiaggia" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
            </VBox>
            <Separator/>
            <VBox spacing="10">
                <Label text="%settings.language.title" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="%settings.language.select" minWidth="200"/>
                    <ComboBox fx:id="comboLanguage" prefWidth="150"/>
                </HBox>
                <Button text="%settings.language.set" onAction="#onSaveLanguageClick"/>
            </VBox>
            <Separator/>
            <VBox spacing="10">
                <Label text="%settings.account.title" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="%settings.account.newpassword" minWidth="200"/>
                    <PasswordField fx:id="newPasswordField" prefWidth="200"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="%settings.account.confirmpassword" minWidth="200"/>
                    <PasswordField fx:id="confirmPasswordField" prefWidth="200"/>
                </HBox>
                <Button text="%settings.account.changepassword" onAction="#onChangePasswordClick"/>
            </VBox>

        </VBox>
    </HBox>
</ScrollPane>
